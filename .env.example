# IdealData kimlik bilgileri
# Bu dosyayi .env olarak kopyalayip degerleri doldurun.
# .env dosyasi .gitignore'dadir, repoya girmez.

STREAM_USERNAME=
STREAM_PASSWORD=
IDEALDATA_API_KEY=

# Opsiyonel — varsayilanlar yeterli
# STREAM_HOST=ssdata1.idealdata.com.tr
# STREAM_PORT=9443
# FRONTEND_BASE_URL=http://127.0.0.1:5173

# --- API erisimi ---
# Bos birakilirsa kimlik dogrulama KAPALIDIR (gelistirme icin).
# Anahtar uretmek icin:  node auth.js --generate
# API_KEYS="partner1:uzunvegizlianahtar"
# AUTH_ALLOW_LOCAL=1      # 0 yapilirsa yerel istekler de anahtar ister
# RATE_LIMIT_RPM=600      # anahtar basina dakikadaki istek

# --- Sayfa korumasi ve TLS ---
# AUTH_PROTECT_PAGES=1    # HTML sayfalari da anahtar ister (cerezle oturum)
# SESSION_SECRET="..."    # cerez imzalama sirri; verilmezse her baslatmada uretilir
# SESSION_TTL_SEC=43200   # oturum omru (varsayilan 12 saat)
# TLS_CERT=dev-cert.pem   # ikisi birden verilirse HTTPS ile calisir
# TLS_KEY=dev-key.pem     # gelistirme sertifikasi:  node auth.js --cert

# --- Kalici durum ---
# Durum dosyalarinin yazilacagi dizin (denetim izi, uyari gecmisi,
# model parametreleri, teklifler, fiyatlama kaydi). Verilmezse kodun
# yanina yazilir. Konteynerde bir birime isaret etmeli, aksi halde pod
# yeniden basladiginda hepsi silinir.
# STATE_DIR=/data
# STORE_DB=/data/derivex.db
